<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ParseStl</RootNamespace>
    <AssemblyName>ParseSTL</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ParseSTL.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Config.json must sit next to the exe. -->
    <None Update="Config.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Sample models, copied into the folder that Config.json points to by default. -->
    <None Update="StlFiles\**\*.stl" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
